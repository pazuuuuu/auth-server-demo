# Database connection (Supabase PostgreSQL)
# Copy this file to .env and fill in real values. Do NOT commit .env.
DB_URL=jdbc:postgresql://<host>:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# OIDC のデモ用クライアント（oidc-client）のシークレット（必須・32文字以上のランダムな値。例: openssl rand -hex 32）
# 空・32文字未満・change-me のままだと起動しない
OIDC_CLIENT_SECRET=change-me

# 利用者に見せる URL の先頭（パスワード再設定リンクに使う）。本番は https の公開 URL にする
APP_BASE_URL=https://auth.example.com

# 開発用プロファイル：DEBUG ログ・デモ利用者・再設定リンクをログに出す。★本番では設定しない（開発するときだけ外す）
# SPRING_PROFILES_ACTIVE=dev
# DEMO_USER_PASSWORD=choose-a-demo-password
